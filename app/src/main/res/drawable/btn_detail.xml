<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#388E3C"/> <!-- Hijau tua saat ditekan -->
            <corners android:radius="8dp"/>
            <stroke android:color="#2E7D32" android:width="2dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#4CAF50"/> <!-- Hijau utama -->
            <corners android:radius="8dp"/>
            <stroke android:color="#388E3C" android:width="2dp"/>
        </shape>
    </item>
</selector>
