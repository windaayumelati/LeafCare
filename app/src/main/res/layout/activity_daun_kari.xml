<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Reusable Toolbar (ditempatkan di luar ScrollView) -->
    <include layout="@layout/toolbar_layout" />

    <!-- Konten Halaman di dalam ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Daun Kari -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:elevation="6dp"
                android:layout_gravity="center"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:src="@drawable/kari" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Daun Kari"
                        android:textColor="#388E3C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Judul Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Daun Kari"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <!-- Isi Deskripsi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daun kari adalah daun aromatik, artinya daun yang memiliki aroma harum dan khas, yang biasa dipakai dalam masakan Asia Selatan. Selain untuk memasak, daun ini juga dikenal bermanfaat untuk kesehatan kulit dan rambut. Daun kari kaya akan antioksidan, yaitu zat yang melindungi sel tubuh dari kerusakan akibat molekul berbahaya yang disebut radikal bebas. Daun ini juga mengandung senyawa antibakteri, yaitu zat yang dapat membunuh atau melawan bakteri penyebab infeksi, serta nutrisi penting seperti vitamin dan mineral yang membantu menjaga kesehatan tubuh secara alami tanpa bahan kimia tambahan."
                        android:textColor="#2E4438"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="8dp" />

                    <!-- Judul Ciri-ciri -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciri-ciri Daun Kari:"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <!-- Isi Ciri-ciri -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Berukuran kecil dan memanjang\n• Tumbuh berkelompok dalam satu tangkai\n• Warna hijau gelap dan mengkilap\n• Aroma khas yang kuat saat diremas\n• Umumnya panjang 2–4 cm per daun"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manfaat Daun Kari untuk Kulit -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manfaat dan Cara Penggunaan Daun Kari untuk Kulit"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#757575"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />


                    <!-- 1. Membantu mempercepat proses regenerasi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Membantu mempercepat proses regenerasi (proses mengganti sel kulit yang rusak atau tua dengan sel baru)"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari mengandung antioksidan (zat yang melindungi sel tubuh dari kerusakan) dan nutrisi yang merangsang pembaruan kulit, sehingga membantu memperbaiki kulit yang kering atau rusak."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tumbuk daun kari hingga halus dan oleskan pada area kulit yang rusak. Diamkan 15-20 menit, lalu bilas dengan air bersih."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 2. Mengurangi kulit berjerawat -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Mengurangi kulit berjerawat"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari memiliki antibakteri (zat yang membunuh atau menghambat pertumbuhan bakteri) yang membantu melawan bakteri penyebab jerawat dan mengurangi peradangan (reaksi tubuh berupa kemerahan, bengkak, dan nyeri) pada kulit."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haluskan daun kari dan oleskan pada area wajah yang berjerawat. Diamkan selama 20 menit, lalu bilas dengan air dingin."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 3. Meredakan gejala eksim -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Meredakan gejala eksim (penyakit kulit kronis yang menyebabkan gatal, merah, dan kering)"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari memiliki sifat anti-inflamasi (kemampuan untuk mengurangi peradangan) yang membantu mengurangi rasa gatal dan kemerahan pada kulit yang terkena eksim."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oleskan daun kari yang sudah dihaluskan pada area kulit yang terkena eksim. Diamkan selama 15 menit, lalu bilas dengan air hangat."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 4. Melawan infeksi bakteri pada kulit -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Melawan infeksi bakteri pada kulit"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari mengandung zat antibakteri yang membantu melawan infeksi (masuknya kuman atau bakteri ke dalam tubuh yang bisa menyebabkan penyakit) dan mempercepat penyembuhan luka ringan."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tumbuk daun kari dan oleskan pada luka atau area yang terinfeksi. Diamkan sebentar lalu bilas dengan air bersih."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 5. Mengurangi iritasi ringan pada kulit -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Mengurangi iritasi ringan pada kulit"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari membantu mengurangi iritasi (rasa tidak nyaman seperti kemerahan atau gatal ringan pada kulit) berkat sifat anti-inflamasi dan antibakterinya, menjaga kulit tetap sehat dan lembap."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gunakan daun kari yang sudah dihaluskan sebagai masker pada area kulit yang terasa iritasi. Diamkan 15 menit lalu bilas dengan air dingin."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manfaat Daun Kari untuk Rambut -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Judul -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manfaat dan Cara Penggunaan Daun Kari untuk Rambut"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#757575"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />


                    <!-- 1. Mengurangi Rambut Rontok -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Mengurangi Rambut Rontok"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari dapat memperkuat akar rambut dan mengurangi kerontokan. Jika daun kari dipanaskan bersama minyak kelapa, akan terbentuk nutrisi penting yang bisa membantu menutrisi rambut dari akarnya."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Panaskan minyak kelapa di atas wajan, masukkan daun kari, dan tunggu hingga muncul endapan hitam. Setelah minyak dingin, oleskan ke kulit kepala dan pijat perlahan."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 2. Menyuburkan Rambut dan Mengurangi Ujung Bercabang -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Menyuburkan Rambut dan Mengurangi Ujung Bercabang"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari dapat membantu pertumbuhan rambut dari akar dan memperbaiki rambut bercabang. Jika digunakan secara rutin, rambut akan tampak lebih sehat dan kuat."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oleskan minyak daun kari ke kulit kepala dan rambut, pijat perlahan, dan biarkan selama 30 menit. Setelah itu, bilas rambut dengan sampo yang ringan."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 3. Menyamarkan Uban Prematur -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Menyamarkan Uban yang Tumbuh Prematur"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun kari mengandung pigmen alami yang bisa membantu memberi warna gelap alami pada rambut. Jika digunakan secara rutin, rambut akan terlihat lebih hitam dan uban dini akan tampak berkurang."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haluskan daun kari lalu campur dengan yogurt atau minyak kelapa. Oleskan pada rambut, diamkan selama 30–45 menit, lalu bilas sampai bersih."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>

</ScrollView>
</LinearLayout>