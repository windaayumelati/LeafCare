<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Reusable Toolbar (ditempatkan di luar ScrollView) -->
    <include layout="@layout/toolbar_layout" />

    <!-- Konten Halaman di dalam ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:elevation="6dp"
                android:layout_gravity="center"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:src="@drawable/pepaya" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Daun Pepaya"
                        android:textColor="#388E3C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Judul Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Daun Pepaya"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <!-- Isi Deskripsi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daun pepaya, yang berasal dari tanaman Carica papaya, adalah daun yang tumbuh di daerah tropis dan sering digunakan dalam pengobatan tradisional. Daun ini mengandung enzim papain, yaitu protein yang membantu memecah makanan dan mempercepat penyembuhan luka. Selain itu, daun pepaya juga kaya akan vitamin A dan C serta antioksidan — zat yang membantu melindungi sel tubuh dari kerusakan akibat radikal bebas. Karena kandungan ini, daun pepaya bermanfaat untuk menjaga kesehatan tubuh, kulit, dan rambut secara alami."
                        android:textColor="#2E4438"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="8dp" />

                    <!-- Judul Ciri-ciri -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciri-ciri Daun Pepaya:"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <!-- Isi Ciri-ciri -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Bentuk menjari menyerupai tangan dengan 5–9 lekukan\n• Ukuran besar, panjang sekitar 30–60 cm\n• Warna hijau tua pada bagian atas, lebih muda di bagian bawah\n• Tangkai daun panjang dan berongga seperti pipa\n• Permukaan daun halus dengan sedikit bulu halus\n• Memiliki rasa pahit khas yang membedakannya"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- Manfaat Daun Pepaya untuk Kulit -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="6dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manfaat dan Cara Penggunaan Daun Pepaya untuk Kulit"
                            android:textColor="#2E4438"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#757575"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />


                        <!-- 1. Obat Alami Herpes -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Obat Alami Herpes"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Daun pepaya mengandung enzim papain, yaitu enzim proteolitik (enzim pemecah protein) alami yang membantu memecah protein. Papain ini bisa membantu meredakan gejala herpes zoster, yaitu infeksi virus yang menyebabkan lepuhan berisi cairan pada kulit dan nyeri saraf (neuralgia). Dalam beberapa kasus, khasiatnya bisa mendekati obat antivirus seperti acyclovir yang bekerja menghambat replikasi virus."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tumbuk daun pepaya hingga halus dan oleskan pada kulit yang terkena herpes. Biarkan selama 15–20 menit, lalu bilas dengan air bersih."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- 2. Mencegah Keriput -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2. Mencegah Keriput"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Daun pepaya kaya akan vitamin C dan antioksidan, yaitu senyawa yang dapat melindungi kulit dari kerusakan akibat radikal bebas (molekul reaktif yang mempercepat penuaan kulit). Antioksidan membantu menghambat radikal bebas sehingga kulit menjadi lebih elastis dan tampak lebih muda dengan berkurangnya garis halus dan keriput."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Haluskan daun pepaya, lalu oleskan ke wajah atau bagian tubuh yang berkerut. Biarkan selama 20 menit, lalu bilas dengan air dingin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- 3. Mencegah Munculnya Jerawat -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3. Mencegah Munculnya Jerawat"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enzim papain dan vitamin A dalam daun pepaya berfungsi sebagai eksfolian alami (pengelupas sel kulit mati) yang membantu membersihkan kulit dari sel mati dan kotoran. Hal ini mencegah penyumbatan pori-pori yang dapat menyebabkan jerawat."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tumbuk daun pepaya hingga halus lalu oleskan pada area wajah yang berjerawat. Diamkan selama 15 menit, lalu bilas dengan air dingin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- 4. Mempercepat Penyembuhan Luka -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="4. Mempercepat Penyembuhan Luka"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Papain dalam daun pepaya mempercepat proses regenerasi kulit, yaitu pembentukan sel kulit baru untuk menggantikan kulit yang rusak. Selain itu, papain memiliki sifat anti-inflamasi yang dapat mengurangi pembengkakan dan peradangan pada luka."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Haluskan daun pepaya lalu tempelkan pada luka atau bekas luka. Biarkan selama 15–20 menit, kemudian bilas hingga bersih."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


            <!-- Manfaat Daun Pepaya untuk Rambut -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Judul -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manfaat dan Cara Penggunaan Daun Pepaya untuk Rambut"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#757575"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <!-- 1. Melebatkan Rambut -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Melebatkan Rambut"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun pepaya mengandung antioksidan, yaitu zat yang melindungi sel tubuh dari kerusakan akibat molekul berbahaya bernama radikal bebas. Zat ini diyakini dapat mempercepat pertumbuhan rambut dan mengurangi kerontokan. Penggunaan sebagai masker rambut dapat membantu menjaga kesehatan rambut dan kulit kepala."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- Cara Penggunaan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tumbuk daun pepaya hingga halus, lalu aplikasikan pada rambut dan kulit kepala. Diamkan selama 20-30 menit, kemudian bilas dengan air bersih."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- 2. Menghilangkan Ketombe -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Menghilangkan Ketombe"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daun pepaya memiliki sifat antijamur, yaitu kemampuan untuk melawan jamur yang bisa menyebabkan ketombe. Ketombe dapat menghambat pertumbuhan rambut dan menurunkan rasa percaya diri. Penggunaan rutin dapat membantu membersihkan kulit kepala dari jamur penyebab ketombe."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                    <!-- Cara Penggunaan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan:"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haluskan daun pepaya, kemudian aplikasikan pada kulit kepala yang berketombe. Diamkan selama 20 menit, lalu bilas dengan air bersih."
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:gravity="start" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>
</LinearLayout>