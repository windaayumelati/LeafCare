<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Reusable Toolbar (ditempatkan di luar ScrollView) -->
    <include layout="@layout/toolbar_layout" />

    <!-- Konten Halaman di dalam ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Daun Kari -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:elevation="6dp"
                android:layout_gravity="center"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:src="@drawable/sirih" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Daun Sirih"
                        android:textColor="#388E3C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Judul Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Daun Sirih"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <!-- Isi Deskripsi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daun sirih, yang secara ilmiah dikenal sebagai Piper betle, adalah tanaman herbal populer di Asia Tenggara. Daun ini memiliki aroma khas yang menyegarkan dan mengandung berbagai senyawa bioaktif seperti minyak atsiri (minyak harum alami yang dapat membunuh kuman), flavonoid (zat alami yang berfungsi sebagai antioksidan, membantu melindungi tubuh dari kerusakan sel), dan tanin (zat yang membantu mengurangi peradangan dan membunuh bakteri). Karena kandungan tersebut, daun sirih sering digunakan dalam pengobatan tradisional untuk menjaga kesehatan mulut, meredakan infeksi, serta merawat kecantikan kulit."
                        android:textColor="#2E4438"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="8dp" />

                    <!-- Judul Ciri-ciri -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciri-ciri Daun Sirih:"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="16dp" />

                    <!-- Isi Ciri-ciri -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Bentuk daun menyerupai hati dengan ujung yang lancip\n• Ukuran daun biasanya sekitar 7-10 cm panjang dan 5-7 cm lebar\n• Warna hijau mengkilap pada permukaan daun\n• Tepi daun bergerigi halus\n• Memiliki aroma tajam dan khas\n• Tumbuh baik di tanah subur dan lembab"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>




                <!-- Manfaat Daun Sirih untuk Kulit -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="6dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manfaat dan Cara Penggunaan Daun Sirih untuk Kulit"
                            android:textColor="#2E4438"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#757575"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />

                        <!-- 1. Menutrisi kulit -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Menutrisi kulit"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih membantu menjaga kelembapan dan kesejukan kulit, sehingga kulit terasa segar dan tidak mudah kering."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haluskan daun sirih segar, campurkan dengan satu sendok makan Multani mitti (tanah liat alami), lalu oleskan ke wajah. Diamkan 15 menit, kemudian bilas dengan air bersih."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- 2. Mencegah jerawat -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Mencegah jerawat"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih memiliki sifat anti-inflamasi (mengurangi peradangan) dan antibakteri (melawan bakteri), yang membantu mengurangi kemerahan dan mencegah munculnya jerawat dan komedo."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan daun sirih yang sudah dihaluskan dengan sedikit kunyit (rempah alami). Gunakan sebagai masker wajah selama 15–20 menit, lalu bilas dengan air dingin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- 3. Mencerahkan kulit -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Mencerahkan kulit"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vitamin dalam daun sirih membantu mengangkat sel kulit mati, sehingga kulit terlihat lebih cerah dan bersinar alami."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haluskan daun sirih hingga menjadi pasta, oleskan ke wajah. Diamkan beberapa menit, lalu bilas dengan air hangat."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- 4. Menghilangkan minyak berlebih -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Menghilangkan minyak berlebih"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih membantu membuka pori-pori dan mengurangi minyak berlebih pada wajah, sehingga kulit terasa lebih bersih dan segar."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan daun sirih yang sudah dihaluskan dengan 2 sendok makan madu dan setengah sendok teh garam laut. Oleskan ke wajah, diamkan 10–15 menit, lalu bilas dengan air bersih."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- Manfaat Daun Sirih untuk Rambut -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="6dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manfaat dan Cara Penggunaan Daun Sirih untuk Rambut"
                            android:textColor="#2E4438"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#757575"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />

                        <!-- 1. Mengurangi Rambut Rontok -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Mengurangi Rambut Rontok"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih mengandung vitamin C yang membantu memperkuat akar rambut sehingga dapat mengurangi kerontokan."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haluskan daun sirih, wijen, jahe, dan minyak kelapa. Oleskan pada kulit kepala, diamkan selama satu jam, lalu bilas dengan sampo bebas bahan kimia (sampo tanpa deterjen keras)."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                        <!-- 2. Meningkatkan Pertumbuhan Rambut -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Meningkatkan Pertumbuhan Rambut"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih dapat merangsang pertumbuhan rambut karena mengandung senyawa aktif alami seperti eugenol (zat antiseptik alami)."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan 5 lembar daun sirih, 2 sendok makan minyak kelapa, 1 sendok teh minyak jarak (castor oil), dan 1 sendok teh air. Oleskan pada kulit kepala seperti masker rambut. Diamkan selama satu jam, lalu bilas dengan sampo ringan dan gunakan kondisioner."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                        <!-- 3. Mencegah Rambut Beruban Dini -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Mencegah Rambut Beruban Dini"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daun sirih mengandung zat alami yang membantu menjaga pigmen rambut sehingga mengurangi risiko rambut beruban sebelum waktunya."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan daun sirih, kembang sepatu, kemangi, dan bunga gulai (bunga yang sering digunakan dalam pengobatan herbal). Tambahkan minyak kelapa atau minyak wijen. Oleskan pada rambut dan kulit kepala satu jam sebelum keramas, lalu bilas dengan sampo."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>
</LinearLayout>