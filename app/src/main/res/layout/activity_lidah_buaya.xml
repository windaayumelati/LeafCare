<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Reusable Toolbar (ditempatkan di luar ScrollView) -->
    <include layout="@layout/toolbar_layout" />

    <!-- Konten Halaman di dalam ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:elevation="6dp"
                android:layout_gravity="center"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:src="@drawable/lidahbuaya" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Lidah Buaya"
                        android:textColor="#388E3C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Judul Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Lidah Buaya"
                        android:textColor="#2E4438"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Isi Deskripsi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lidah buaya adalah tanaman yang terkenal akan manfaatnya untuk kesehatan dan kecantikan. Daunnya tebal dan berdaging, berisi gel bening kaya nutrisi yang memiliki sifat anti-inflamasi (mengurangi peradangan atau bengkak), antibakteri (melawan bakteri penyebab infeksi), serta melembapkan secara alami, sangat efektif untuk perawatan kulit dan rambut."
                        android:textColor="#2E4438"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif" />

                    <!-- Judul Ciri-ciri -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciri-ciri Lidah Buaya:"
                        android:textColor="#2E4438"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Isi Ciri-ciri -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Daun tebal dan berdaging\n• Berisi gel bening di bagian dalam\n• Warna hijau dengan bintik putih pada beberapa jenis\n• Tepi daun bergerigi kecil\n• Daun tumbuh berkelompok dari pangkal tanaman"
                        android:textColor="#2E4438"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>





            <!-- Manfaat Lidah Buaya untuk Kulit -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="6dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manfaat dan Cara Penggunaan Lidah Buaya untuk Kulit"
                            android:textColor="#2E4438"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#757575"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />


                        <!-- Mencegah Penuaan Dini -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Mencegah Penuaan Dini"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lidah buaya membantu mencegah tanda-tanda awal penuaan seperti keriput dan garis halus."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan 1 sdt gel lidah buaya, ½ sdt minyak zaitun (minyak dari buah zaitun yang kaya antioksidan, yaitu zat yang membantu melindungi kulit dari kerusakan), dan 1 sdt oatmeal instan. Aduk hingga menjadi pasta dan oleskan pada wajah. Diamkan selama 30 menit, lalu bilas dengan air dingin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- Melembabkan Kulit -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Melembabkan Kulit"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gel lidah buaya cocok untuk semua jenis kulit, termasuk kulit berminyak dan berjerawat."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kupas daun lidah buaya dan ambil gelnya. Pijatkan secara lembut pada wajah."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- Mengatasi Jerawat -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Mengatasi Jerawat"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lidah buaya mengandung sifat anti-inflamasi (mengurangi peradangan atau bengkak) dan antibakteri (melawan bakteri penyebab jerawat) yang membantu mengurangi jerawat dan bekasnya."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan 1 sdm gel lidah buaya dengan 2–3 tetes jus lemon. Oleskan pada wajah, terutama saat malam hari."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- Menyembuhkan Luka Eksternal -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Menyembuhkan Luka Eksternal"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aloe vera (nama ilmiah lidah buaya) efektif dalam mengobati luka kecil, memar, dan gigitan serangga karena sifat anti-inflamasinya (mengurangi pembengkakan dan nyeri)."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                        <!-- Mengurangi Stretch Marks -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5. Mengurangi Stretch Marks"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stretch mark adalah garis-garis atau bekas pada kulit yang muncul akibat peregangan kulit, misalnya karena kehamilan atau perubahan berat badan. Penggunaan rutin gel atau sabun lidah buaya dapat membantu menyamarkan tanda ini."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="6dp"
                            android:gravity="start" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>



                <!-- Manfaat Lidah Buaya untuk Rambut -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="6dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manfaat dan Cara Penggunaan Lidah Buaya untuk Rambut"
                            android:textColor="#2E4438"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#757575"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />


                        <!-- Merangsang Pertumbuhan Rambut -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Merangsang Pertumbuhan Rambut"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="12dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kombinasi lidah buaya dan minyak jarak dapat merangsang pertumbuhan rambut secara alami. Minyak jarak mengandung asam risinoleat yang membantu memperlancar sirkulasi darah di kulit kepala."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan gel lidah buaya dengan minyak jarak, oleskan ke kulit kepala, dan pijat dengan lembut selama 5–10 menit. Diamkan selama 30 menit, lalu bilas dengan air."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- Mengurangi Ketombe -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Mengurangi Ketombe"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lidah buaya sering dijadikan bahan dasar sampo karena efektif dalam mengatasi ketombe dan kulit kepala gatal. Ketombe adalah serpihan kulit mati yang menumpuk di kulit kepala."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campurkan gel lidah buaya dengan air perasan lemon, aplikasikan pada kulit kepala, diamkan selama 20–30 menit, lalu bilas dengan sampo."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- Memperkuat dan Menyehatkan Rambut -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Memperkuat dan Menyehatkan Rambut"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mengandung asam lemak (zat penting untuk pertumbuhan), asam amino (bahan penyusun protein), serta vitamin A, B12, C, dan E yang bermanfaat untuk kesehatan folikel rambut (akar rambut)."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gunakan sampo atau masker rambut berbahan dasar lidah buaya untuk merawat rambut secara rutin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <!-- Mengontrol Rambut Berminyak -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Mengontrol Rambut Berminyak"
                            android:textColor="#2E4438"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enzim dalam gel lidah buaya membantu memecah lemak dan mengurangi kelebihan minyak (sebum, yaitu zat minyak alami yang diproduksi kulit kepala) di rambut."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara Penggunaan:"
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oleskan gel lidah buaya secara merata pada rambut dan kulit kepala. Diamkan selama 20 menit, lalu bilas dengan air dingin."
                            android:textColor="#2E4438"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>
</LinearLayout>